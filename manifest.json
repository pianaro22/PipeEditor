{
  "manifestVersion": 5,
  "id": "com.pipe.editorai.dev",
  "name": "Pipe Editor AI",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "pipeEditorPanel",
      "label": {
        "default": "Pipe Editor AI"
      },
      "minimumSize": {
        "width": 300,
        "height": 360
      },
      "preferredDockedSize": {
        "width": 340,
        "height": 540
      }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request"
  }
}